{
  "name": "simple-jwt-login-website",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "prestart": "yarn gen-api",
    "start": "docusaurus start",
    "prebuild": "yarn gen-api",
    "build": "docusaurus build",
    "postbuild": "bash scripts/trailing-slash-redirects.sh",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "lint:vale": "bash scripts/vale.sh",
    "validate-openapi": "redocly lint --extends=spec static/openapi/*.yaml",
    "gen-api-v4": "docusaurus clean-api-docs all --plugin-id openapi-v4 && docusaurus gen-api-docs all --plugin-id openapi-v4 && node scripts/patch-openapi-sidebar.mjs",
    "gen-api-v3": "docusaurus clean-api-docs all --plugin-id openapi-v3 && docusaurus gen-api-docs all --plugin-id openapi-v3",
    "gen-api": "mkdir -p api/v3 api/v4 && yarn gen-api-v4 && yarn gen-api-v3",
    "spellcheck": "cspell --config .cspell.json 'docs/**/*.{md,mdx}' 'blog/**/*.md' 'releases/**/*.md' 'src/**/*.{jsx,tsx,ts}'",
    "optimize-images": "bash scripts/optimize-images.sh"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/plugin-client-redirects": "^3.10.2",
    "@docusaurus/plugin-sitemap": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.1",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.0",
    "@mdx-js/react": "^3.1.1",
    "@signalwire/docusaurus-plugin-llms-txt": "^1.2.2",
    "clsx": "^2.0.0",
    "docusaurus-plugin-dotenv": "^1.0.1",
    "docusaurus-plugin-openapi-docs": "^5.2.0",
    "docusaurus-theme-openapi-docs": "^5.2.0",
    "docusaurus2-dotenv": "^1.4.0",
    "path-browserify": "^1.0.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "optionalDependencies": {
    "@vvago/vale": "^3.25.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@redocly/cli": "^2.83.0",
    "cspell": "^8.0.0",
    "sharp-cli": "^5.2.0",
    "svgo": "^4.0.1",
    "typescript": "~6.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=19.0"
  }
}
